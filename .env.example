# Swaggen Backend Environment Template
# Copy to `.env` for local Docker Compose (never commit `.env` to Git),
# or configure these variables directly in Coolify -> Environment Variables.

# [REQUIRED] MongoDB Replica Set connection URI (transactions required)
# Example: mongodb://user:password@mongo-host:27017/swaggen?replicaSet=rs0&authSource=admin
SWAGGEN_MONGO_URI=

# [OPTIONAL] Target MongoDB database name (default: swaggen)
SWAGGEN_MONGO_DB=swaggen

# [OPTIONAL - ONE-TIME] Random secret token (e.g. 32-byte hex) for initial Server Owner creation.
# Unset/empty this variable and redeploy once the first Owner account has been created.
SWAGGEN_BOOTSTRAP_TOKEN=

# [OPTIONAL] Host loopback port mapped by docker-compose.yml (default: 8080)
SWAGGEN_PORT=8080
