    <text id="18:30" name="Connected brackets. One shared workflow." x="64" y="378" width="432" height="28" />
    <text id="18:31" name="The S mark links API design and API testing. Keep the mark clear, compact and legible in the Windows titlebar, activity rail and app icon." x="64" y="446" width="1250" height="22" />
    <text id="18:32" name="Use the brand mark on white. Brand accents are exceptional; normal UI surfaces stay white. Minimum mark size: 24 px. Clear space: half the mark width." x="64" y="508" width="1250" height="44" />
    <text id="18:33" name="Do not stretch, rotate or recolor individual parts. Use the Brand/Mark and Brand/Wordmark components from the component library." x="64" y="592" width="1250" height="20" />
    <text id="18:34" name="Design library → 01 Components Product flows → 02–06 Requirement map → 07" x="64" y="652" width="616" height="20" />
  </frame>
