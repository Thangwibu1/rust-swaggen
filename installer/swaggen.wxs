<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef DisplayVersion ?>
    <?define DisplayVersion = "$(var.AppVersion)" ?>
  <?endif?>
  <Package
    Name="Swaggen"
    Manufacturer="Swaggen"
    Version="$(var.AppVersion)"
    UpgradeCode="94E4F862-C312-4F55-9713-34AB62C1E77F"
    Scope="perUser">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Swaggen is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Brand Logo & Full Step-by-Step Interactive Wizard (Welcome -> License -> Choose Folder -> Install -> Finish) -->
    <Icon Id="SwaggenIcon.ico" SourceFile="assets\swaggen.ico" />
    <Property Id="ARPPRODUCTICON" Value="SwaggenIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="Swaggen v$(var.DisplayVersion)" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Thangwibu1/rust-swaggen/releases" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\LICENSE.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="installer\assets\msi-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="installer\assets\msi-dialog.bmp" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Swaggen">
        <Directory Id="BINFOLDER" Name="bin" />
        <Directory Id="ASSETSFOLDER" Name="assets" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Swaggen" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Swaggen Desktop &amp; CLI" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="BrandIconComponent" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ComponentGroup Id="ProductComponents" Directory="BINFOLDER">
      <Component Id="SwaggenDesktopExe" Guid="1A2C4E6F-8B0D-4C2E-9F1A-2B3C4D5E6F01">
        <File Id="SwaggenDesktopFile" Source="$(var.BundleDir)\bin\swaggen-desktop.exe" KeyPath="yes" />
      </Component>
      <Component Id="SwaggenCliExe" Guid="1A2C4E6F-8B0D-4C2E-9F1A-2B3C4D5E6F02">
        <File Id="SwaggenCliFile" Source="$(var.BundleDir)\bin\swaggen-cli.exe" KeyPath="yes" />
        <Environment Id="UpdateUserPath" Name="PATH" Value="[BINFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
      </Component>
    </ComponentGroup>

    <Component Id="BrandIconComponent" Directory="ASSETSFOLDER" Guid="1A2C4E6F-8B0D-4C2E-9F1A-2B3C4D5E6F05">
      <File Id="SwaggenIcoFile" Source="assets\swaggen.ico" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder" Guid="1A2C4E6F-8B0D-4C2E-9F1A-2B3C4D5E6F03">
      <Shortcut Id="SwaggenStartMenuShortcut" Name="Swaggen" Target="[BINFOLDER]swaggen-desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="SwaggenIcon.ico" />
      <RemoveFolder Id="CleanStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Swaggen\Installed" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="1A2C4E6F-8B0D-4C2E-9F1A-2B3C4D5E6F04">
      <Shortcut Id="SwaggenDesktopShortcut" Name="Swaggen" Target="[BINFOLDER]swaggen-desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="SwaggenIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\Swaggen\Installed" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
